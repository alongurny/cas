  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  }
}
