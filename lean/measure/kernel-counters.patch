@@ -272,12 +276,39 @@ environment environment::add(declaration const & d, bool check) const {
 addDeclCore (env : Environment) (maxHeartbeats : USize) (decl : @& Declaration)
   (cancelTk? : @& Option IO.CancelToken) : Except Kernel.Exception Environment
 */
+void report_kstats(declaration const & d) {
+    static char const * path = getenv("LEAN_KERNEL_STATS");
+    kernel_stats s = g_kstats();
+    g_kstats() = kernel_stats();
+    if (!path) return;
+    static char const * kinds[] = {"axiom", "def", "thm", "opaque", "quot", "mutual", "inductive"};
+    std::string nm = "-";
+    switch (d.kind()) {
+    case declaration_kind::Axiom: case declaration_kind::Definition:
+    case declaration_kind::Theorem: case declaration_kind::Opaque:
+        nm = static_cast<constant_val const &>(cnstr_get_ref(cnstr_get_ref(d, 0), 0)).get_name().to_string(); break;
+    case declaration_kind::MutualDefinition:
+        nm = head(d.to_definition_vals()).get_name().to_string(); break;
+    default: break;
+    }
+    FILE * f = fopen(path, "a");
+    if (!f) return;
+    fprintf(f, "%s\t%s\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n", kinds[static_cast<int>(d.kind())], nm.c_str(),
+            s.infer_check, s.infer_only, s.infer_hit, s.whnf_core, s.whnf_core_hit, s.whnf, s.whnf_hit,
+            s.defeq_core, s.defeq_true, s.defeq_equiv_hit, s.defeq_fail, s.unfold, s.nat);
+    fclose(f);
+}
+
 extern "C" LEAN_EXPORT object * lean_add_decl(object * env, size_t max_heartbeat, object * decl,
     object * opt_cancel_tk) {
     scope_max_heartbeat s(max_heartbeat);
     scope_cancel_tk s2(is_scalar(opt_cancel_tk) ? nullptr : cnstr_get(opt_cancel_tk, 0));
+    g_kstats() = kernel_stats();
+    declaration dd(decl, true);
     return catch_kernel_exceptions<environment>([&]() {
-            return environment(env).add(declaration(decl, true));
+            environment r = environment(env).add(dd);
+            report_kstats(dd);
+            return r;
         });
 }
 
diff --git a/src/kernel/kstats.h b/src/kernel/kstats.h
new file mode 100644
index 0000000..01234e2
--- /dev/null
+++ b/src/kernel/kstats.h
@@ -0,0 +1,14 @@
+#pragma once
+// Counters for measuring how much work the kernel does per declaration
+// (local instrumentation for the zkPi row-count measurement).
+namespace lean {
+struct kernel_stats {
+    unsigned long long infer_check = 0, infer_only = 0, infer_hit = 0;
+    unsigned long long whnf_core = 0, whnf_core_hit = 0, whnf = 0, whnf_hit = 0;
+    unsigned long long defeq_core = 0, defeq_true = 0, defeq_equiv_hit = 0, defeq_fail = 0;
+    unsigned long long unfold = 0, nat = 0;
+};
+kernel_stats & g_kstats();
+class declaration;
+void report_kstats(declaration const & d);
+}
